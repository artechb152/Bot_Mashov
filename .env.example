# Copy this file to ".env.local" and fill in a real value.
#
# MongoDB connection string. Read by the app's DB layer (src/lib/db/mongoose.ts)
# and by the seed script (scripts/seed.ts). Nothing connects at startup — the app
# boots without this set, as long as no DB-backed route or the seed actually runs.
#
#   Local:  mongodb://localhost:27017/matzpen
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/matzpen
MONGODB_URI=

# Secret used to sign the auth session JWT (HS256). Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# NOTE: The old permanent ADMIN_SIGNUP_CODE has been removed. Admin accounts are now
# created via one-time, per-course, expiring invite codes issued by a super-admin
# from /system/invites. Protected root super-admins are created only by the local
# `npm run admin:create-root` script — never via an env var or any API.

# AI provider selection (server-only). The AI layer is provider-agnostic:
#   - "null" / unset      → Null Provider: features report "AI לא מחובר עדיין"
#                           (never a fake result). Production default.
#   - "mock"              → deterministic DEV-ONLY Mock Provider (no LLM). In
#                           production "mock" is downgraded to Null automatically.
#   - "openai"            → real OpenAI provider (Responses API). Requires
#                           OPENAI_API_KEY and OPENAI_MODEL below; missing either
#                           surfaces as not_configured / configuration_error.
#   - "gemini"            → Google Gemini provider (REST). Requires GEMINI_API_KEY and
#                           GEMINI_MODEL below; missing either surfaces as
#                           not_configured / configuration_error.
#   - any other value     → treated as a safe configuration error (falls back to Null).
AI_PROVIDER=null

# OpenAI credentials (server-only; used ONLY when AI_PROVIDER=openai). Never commit a
# real key. The model is NOT hard-coded — it is read from OPENAI_MODEL. For cost, the
# recommended default is the economical "gpt-5.6-luna" (same model for every task for
# now; per-task models may come later). If that id is unavailable on your account, set
# any valid current OpenAI model id here. Leave both blank in the example; set real
# values in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google Gemini credentials (server-only; used ONLY when AI_PROVIDER=gemini). Get a key at
# https://aistudio.google.com/apikey and paste it in .env.local (never commit a real key).
# The model is read from GEMINI_MODEL — set any valid Gemini model id (e.g. gemini-3.5-flash-lite).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
