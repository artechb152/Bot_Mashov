# Copy this file to ".env.local" and fill in a real value.
#
# MongoDB connection string. Read by the app's DB layer (src/lib/db/mongoose.ts)
# and by the seed script (scripts/seed.ts). Nothing connects at startup — the app
# boots without this set, as long as no DB-backed route or the seed actually runs.
#
#   Local:  mongodb://localhost:27017/matzpen
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/matzpen
MONGODB_URI=

# Secret used to sign the auth session JWT (HS256). Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# NOTE: The old permanent ADMIN_SIGNUP_CODE has been removed. Admin accounts are now
# created via one-time, per-course, expiring invite codes issued by a super-admin
# from /system/invites. Protected root super-admins are created only by the local
# `npm run admin:create-root` script — never via an env var or any API.
