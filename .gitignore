# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# archived pre-rebuild scaffold (kept for reference, excluded from build/tooling)
/_archive_scaffold/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# local env files
.env
.env*.local

# local-only dev artifacts (e.g. generated test credentials — never commit)
/.local/

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Claude Code per-developer settings (holds the local Impeccable hook wiring)
.claude/settings.local.json
# Impeccable per-developer config and hook cache (shared .impeccable/config.json stays tracked)
.impeccable/config.local.json
.impeccable/hook.cache.json

# Playwright MCP output
.playwright-mcp/
